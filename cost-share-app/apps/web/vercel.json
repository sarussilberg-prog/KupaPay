{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "bash scripts/vercel-should-build.sh",
  "framework": "nextjs",
  "installCommand": "cd ../.. && npm install --include=optional",
  "buildCommand": "bash scripts/build-web-next.sh",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.kupa-pay.com" }],
      "destination": "https://kupa-pay.com/:path*",
      "permanent": true
    }
  ]
}
