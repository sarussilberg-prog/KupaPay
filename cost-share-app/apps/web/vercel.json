{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "dev": true
    }
  },
  "ignoreCommand": "bash scripts/vercel-should-build.sh web",
  "framework": "nextjs",
  "installCommand": "cd ../.. && npm install --include=optional",
  "buildCommand": "bash scripts/build-web-next.sh",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.kupa-pay.com" }],
      "destination": "https://kupa-pay.com/:path*",
      "permanent": true
    }
  ]
}
