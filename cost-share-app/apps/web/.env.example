# Copy to .env.local — local dev only (project drxfbicunusmipdgbgdk).
NEXT_PUBLIC_SUPABASE_URL=https://drxfbicunusmipdgbgdk.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_dev_publishable_key

# Auth redirect URLs: see apps/mobile/.env.example comments or Supabase Dashboard

# Expo web proxy (Vercel marketing builds — see app-proxy.*.defaults; optional locally):
# APP_PROXY_ORIGIN=https://kupa-dev.vercel.app

# Sentry (optional locally; set in Vercel for previews/prod). Runtime no-ops when DSN unset.
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# Build-time source maps (Vercel only — optional; upload skipped when unset):
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=kupay-hb
# SENTRY_PROJECT=kupapay-web
