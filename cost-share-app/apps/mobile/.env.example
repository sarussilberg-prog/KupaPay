# Copy to .env — local dev only (project drxfbicunusmipdgbgdk).
# Production EAS: copy this file to .env.production with jfqxjjjbpxbwwvoygahu keys (see docs/SSOT/SUPABASE_ENVIRONMENTS.md).
EXPO_PUBLIC_SUPABASE_URL=https://drxfbicunusmipdgbgdk.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_dev_publishable_key

# Production web origin (invites, native OAuth fallback). Local Expo web uses window.location instead.
EXPO_PUBLIC_WEB_APP_URL=https://kupa-pay.com
# Web application OAuth client — also set in Supabase → Auth → Google.
# Android OAuth client (…k0qh0eap…) is ONLY in Google Cloud: package com.kupapay.mobile + SHA-1.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=93908207560-8m4mo0bu7edbsh2l9nd6bpbkq6ai2a20.apps.googleusercontent.com
# iOS OAuth client — drives the native Google account sheet on iOS. Also added to Supabase → Auth → Google → Client IDs.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=93908207560-0fel0f2qk3oi5gpbj242nhumr3j5cfqp.apps.googleusercontent.com

# Supabase Auth → URL Configuration → Redirect URLs (dev + prod) — required for iOS / web / fallback OAuth:
#   com.kupapay.mobile://auth/callback
#   exp://<LAN_IP>:8081/--/auth/callback  (Expo Go only)
#   http://localhost:8081/auth/callback  (and your LAN :8081 URL if you test Expo web on device)
# If this list is missing the native URI, Supabase redirects to Site URL (EXPO_PUBLIC_WEB_APP_URL) instead.
EXPO_PUBLIC_APP_STORE_URL=https://apps.apple.com/us/app/kupapay/id6780216665
EXPO_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.kupapay.mobile
EXPO_PUBLIC_SUPPORT_EMAIL=sarussilberg@gmail.com

# Sentry error tracking (EU/de.sentry.io). Set empty to disable locally.
EXPO_PUBLIC_SENTRY_DSN=https://0687aa5ff4ed935fca55cbf504f18fc3@o4511495924023297.ingest.de.sentry.io/4511496059682896
EXPO_PUBLIC_SENTRY_ENVIRONMENT=development
# Source maps upload on EAS/local Release only when set (org kupay-hb):
# SENTRY_AUTH_TOKEN=

# PostHog product analytics (EU). Set EXPO_PUBLIC_POSTHOG_KEY= to disable; omit for embedded public default.
# EXPO_PUBLIC_POSTHOG_KEY=phc_umvGfkx4Qoa272QiFeNs9WKe2j6C8HQSJfMpUjkaqmhp
# EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Re-enable Go Pro / Pro promo interstitial when the paid tier ships (default: hidden).
# EXPO_PUBLIC_SHOW_KUPAPAY_PRO_UPSELL=true

# KupaPay Pro v1 (RevenueCat). Default off — safe to ship without store products.
# EXPO_PUBLIC_KUPAPAY_PRO_ENABLED=true
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_...
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_...
# EXPO_PUBLIC_REVENUECAT_OFFERING_ID=default
