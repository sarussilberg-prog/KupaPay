{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "asc-screenshots": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_ASC_SCREENSHOT_DEMO": "true",
        "EXPO_PUBLIC_KUPAPAY_PRO_ENABLED": "true",
        "EXPO_PUBLIC_WEB_APP_URL": "https://kupa-pay.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_WEB_APP_URL": "https://kupa-pay.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_WEB_APP_URL": "https://kupa-pay.com",
        "EXPO_PUBLIC_ADMOB_IOS_APP_ID": "ca-app-pub-8860544182475196~4183153126",
        "EXPO_PUBLIC_ADMOB_ANDROID_APP_ID": "ca-app-pub-8860544182475196~8155234876"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "sarussilberg@gmail.com",
        "ascAppId": "6780216665"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "internal",
        "releaseStatus": "draft",
        "changesNotSentForReview": false
      }
    },
    "play-production": {
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "production",
        "releaseStatus": "completed",
        "changesNotSentForReview": false
      }
    }
  }
}
