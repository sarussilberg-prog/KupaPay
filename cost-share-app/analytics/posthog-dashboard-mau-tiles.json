{
  "name": "KupaPay MAU (1000 epic)",
  "description": "Source spec for posthog-ensure-mau-dashboard-tiles.mjs (#422 / #584). DAU/WAU/MAU expand to platform + locale breakdowns.",
  "tiles": [
    {
      "name": "DAU",
      "insight": { "kind": "Trends", "event": "app_open", "math": "dau", "interval": "day", "breakdown": "properties.platform" }
    },
    {
      "name": "WAU",
      "insight": { "kind": "Trends", "event": "app_open", "math": "weekly_active", "interval": "week", "breakdown": "properties.platform" }
    },
    {
      "name": "MAU",
      "insight": { "kind": "Trends", "event": "app_open", "math": "monthly_active", "interval": "month", "breakdown": "properties.platform" }
    },
    {
      "name": "North star groups (month)",
      "insight": { "kind": "SQL", "file": "posthog-growth-queries.hogql", "note": "north_star_groups query" }
    },
    {
      "name": "Activation funnel",
      "insight": {
        "kind": "Funnel",
        "steps": ["signup", "group_created", "expense_added"],
        "conversionWindowDays": 14,
        "breakdown": "properties.platform"
      }
    },
    {
      "name": "Invite funnel",
      "insight": {
        "kind": "Funnel",
        "steps": ["invite_sent", "invite_accepted", "expense_added"],
        "conversionWindowDays": 14,
        "breakdown": "properties.platform"
      }
    },
    {
      "name": "Paywall funnel",
      "insight": {
        "kind": "Funnel",
        "steps": ["paywall_view", "trial_start", "purchase_completed"],
        "conversionWindowDays": 30,
        "breakdown": "properties.platform"
      }
    }
  ]
}
